{
  "info": {
    "name": "NASCAR Driver Anomaly API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Assignment 4 — Pipeline API deployed on Modal. All requests hit the live deployed URL, not localhost."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ebut11--nascar-driver-anomaly-api-fastapi-app.modal.run"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service is up and named correctly', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.service).to.eql('nascar-driver-anomaly');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Pipeline Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Artifact metadata has learned state, not a fresh rebuild', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.metadata.steps).to.include.members(['engineer', 'scaler', 'neighbors']);",
              "    pm.expect(body.metadata.n_drivers).to.be.above(0);",
              "    pm.expect(body.metadata).to.have.property('built_at');",
              "    pm.expect(body.metadata).to.have.property('sklearn_version');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid Anomaly Score (200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver\": \"Test Driver\",\n  \"asp\": 10,\n  \"arp\": 9,\n  \"afp\": 8,\n  \"succ_pct\": 90,\n  \"pgae_per_100\": 2.5,\n  \"gr_lr\": 0.3,\n  \"ss\": 4.1,\n  \"cpoms\": 0.98\n}"
        },
        "url": { "raw": "{{base_url}}/anomaly-score", "host": ["{{base_url}}"], "path": ["anomaly-score"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns an anomaly score and 5 nearest drivers', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.driver).to.eql('Test Driver');",
              "    pm.expect(body.anomaly_score).to.be.a('number');",
              "    pm.expect(body.nearest_drivers).to.have.lengthOf(5);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid Anomaly Score (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver\": \"Bad Input\",\n  \"asp\": 999,\n  \"arp\": 9,\n  \"afp\": 8,\n  \"succ_pct\": 90,\n  \"pgae_per_100\": 2.5,\n  \"gr_lr\": 0.3,\n  \"ss\": 4.1,\n  \"cpoms\": 0.98\n}"
        },
        "url": { "raw": "{{base_url}}/anomaly-score", "host": ["{{base_url}}"], "path": ["anomaly-score"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Out-of-bounds asp is rejected with 422', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
